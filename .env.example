# ============================================================
# TAARA Backend — Environment Variables (example)
# Copier vers .env et remplir les vraies valeurs.
# ============================================================

NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------
# Database — Neon (PostgreSQL serverless)
# -----------------------------------------------------------
# Connection pooler (PgBouncer) pour l'application en runtime.
# Important : pgbouncer=true requis pour Prisma sur PgBouncer mode transaction.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/taara?sslmode=require&pgbouncer=true&connect_timeout=15"

# Connexion DIRECTE (sans -pooler) pour les migrations Prisma.
# Indispensable, sinon `prisma migrate` échoue (P1001 ou prepared statements bloqués).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/taara?sslmode=require&connect_timeout=15"

# Astuce : ne PAS mettre `channel_binding=require` — Prisma ne le supporte pas correctement.

# -----------------------------------------------------------
# JWT
# -----------------------------------------------------------
JWT_ACCESS_SECRET=change-me-please-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-please-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------
# Cloudinary
# -----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=taara

# -----------------------------------------------------------
# Email — MAIL_PROVIDER = console (log en dev) | resend | sendgrid
# En mode console, le contenu des emails (liens + codes) est loggé.
# -----------------------------------------------------------
# Base des liens envoyés par email (vérification / reset)
APP_URL=https://taara.app
MAIL_FROM="TAARA <no-reply@taara.app>"
MAIL_PROVIDER=console  # console | sendgrid | resend
SENDGRID_API_KEY=
RESEND_API_KEY=

# -----------------------------------------------------------
# Gemma / IA (proxy pour la Phase 2)
# -----------------------------------------------------------
GEMMA_API_URL=
GEMMA_API_KEY=

# -----------------------------------------------------------
# IA — Gemma 4 via l'API Gemini (https://aistudio.google.com/apikey)
# L'app mobile passe par POST /api/v1/ai/generate : la clé reste ici.
# -----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# -----------------------------------------------------------
# Abonnements des pros (modèle économique TAARA)
# Le client paie le pro en direct ; le pro paie son abonnement par
# Mobile Money au numéro TAARA, puis un admin l'active dans la console.
# -----------------------------------------------------------
# Mois d'essai gratuit offerts à chaque nouveau pro (0 = aucun)
PRO_TRIAL_MONTHS=3
# Prix de l'abonnement mensuel en FCFA
SUBSCRIPTION_MONTHLY_PRICE=5000
# Numéros TAARA affichés aux pros pour payer leur abonnement
SUBSCRIPTION_TMONEY_NUMBER=
SUBSCRIPTION_FLOOZ_NUMBER=

# -----------------------------------------------------------
# Paiements (Phase 4)
# -----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ORANGE_MONEY_API_KEY=
MTN_MONEY_API_KEY=

# -----------------------------------------------------------
# Firebase Cloud Messaging (Phase 5)
# -----------------------------------------------------------
FCM_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------
# Throttling
# -----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# -----------------------------------------------------------
# Observabilité — Sentry (optionnel, recommandé en prod)
# Si SENTRY_DSN est vide, l'init Sentry est skip silencieusement.
# -----------------------------------------------------------
SENTRY_DSN=
SENTRY_RELEASE=
